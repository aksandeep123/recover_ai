# -----------------------------------------------------------------------------
# RecoverAI — Environment Variables Configuration Template
# Copy this file to '.env' at the project root and fill in your keys.
# -----------------------------------------------------------------------------

# 1. Database Configuration (Defaults to SQLite in backend/recoverai.db)
DATABASE_URL=sqlite:///./backend/recoverai.db

# 2. Safety & Policy Thresholds
MAX_RETRIES=2
MAX_RECOVERY_WINDOW_HOURS=48
HIGH_VALUE_THRESHOLD_INR=20000.0

# 3. AI LLM API Key (Optional; used by agents for deep reasoning and Hinglish outputs)
# Enter your Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 4. Razorpay Test Credentials (Optional; for real test-mode payment link generation)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
